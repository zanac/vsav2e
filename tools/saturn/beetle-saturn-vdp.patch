index 2a72b71..b71f204 100644
--- a/mednafen/ss/ss.c
+++ b/mednafen/ss/ss.c
@@ -2703,3 +2703,16 @@ int LibRetro_StateAction(StateMem* sm, const unsigned load)
 
    return 1;
 }
+
+
+/* Development hook (not part of the core proper): a histogram of the addresses the two
+ * SH-2s executed, indexed by (PC >> 1) & 0x7fffff, for finding what code runs while the
+ * game does something (tools/saturn/satrun.c, PCHIST). Passing clear != 0 zeroes it. */
+uint32_t SS_DevPcHist[2][0x800000];
+const uint32_t *retro_dev_pc_hist(int cpu, int clear)
+{
+ static uint32_t copy[0x800000];
+ memcpy(copy, SS_DevPcHist[cpu], sizeof copy);
+ if(clear) memset(SS_DevPcHist[cpu], 0, sizeof copy);
+ return copy;
+}
